# Backend
PORT=3000
NODE_ENV=development

# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://tessera:tessera@localhost:5432/tessera?schema=public"

# JWT — generate a strong random value, e.g. `openssl rand -hex 64`
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Plugins directory (relative to project root). Defaults to "plugins".
PLUGINS_DIR="plugins"

# Allow new accounts to be created via /api/auth/register (true|false). Default false.
ALLOW_REGISTER=false

# Max concurrent ffmpeg post-processing jobs. Lower for weak CPUs. Default 5.
POST_PROCESS_CONCURRENCY=5
